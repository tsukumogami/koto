{
  "format_version": 1,
  "name": "structured-routing",
  "version": "1.0",
  "description": "Routes based on gates.* exit_code in when clauses",
  "initial_state": "check",
  "states": {
    "check": {
      "directive": "Run ci_check gate (test -f wip/flag.txt) and route based on exit code.\nIf wip/flag.txt exists, the gate exits 0 and routes to pass.\nIf wip/flag.txt is absent, the gate exits 1 and routes to fix.",
      "transitions": [
        {
          "target": "pass",
          "when": {
            "gates.ci_check.exit_code": 0
          }
        },
        {
          "target": "fix",
          "when": {
            "gates.ci_check.exit_code": 1
          }
        }
      ],
      "gates": {
        "ci_check": {
          "type": "command",
          "command": "test -f wip/flag.txt"
        }
      }
    },
    "fix": {
      "directive": "Gate failed, fix required.",
      "terminal": true
    },
    "pass": {
      "directive": "Gate passed.",
      "terminal": true
    }
  }
}