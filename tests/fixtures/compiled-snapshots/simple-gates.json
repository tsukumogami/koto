{
  "format_version": 1,
  "name": "simple-gates",
  "version": "1.0",
  "description": "Tests gate-with-evidence-fallback behavior",
  "initial_state": "start",
  "states": {
    "done": {
      "directive": "Gate test complete.",
      "terminal": true
    },
    "start": {
      "directive": "Check whether wip/check.txt exists. If the gate passes, auto-advance. If it fails, provide evidence to proceed.",
      "transitions": [
        {
          "target": "done",
          "when": {
            "gates.check_file.exit_code": 0
          }
        },
        {
          "target": "done",
          "when": {
            "gates.check_file.exit_code": 1,
            "status": "completed"
          }
        },
        {
          "target": "done",
          "when": {
            "gates.check_file.exit_code": 1,
            "status": "override"
          }
        }
      ],
      "gates": {
        "check_file": {
          "type": "command",
          "command": "test -f wip/check.txt"
        }
      },
      "accepts": {
        "detail": {
          "field_type": "string",
          "required": false
        },
        "status": {
          "field_type": "enum",
          "required": true,
          "values": [
            "completed",
            "override",
            "blocked"
          ]
        }
      }
    }
  }
}