{
  "format_version": 1,
  "name": "warn-triggers",
  "version": "1.0",
  "description": "Template with a terminal state name that triggers the W3 warning",
  "initial_state": "start",
  "states": {
    "done": {
      "directive": "Completed successfully.",
      "terminal": true
    },
    "failed_result": {
      "directive": "Terminal failure state. Name contains \"fail\" without `failure: true` — triggers W3.",
      "terminal": true
    },
    "start": {
      "directive": "Choose an outcome.",
      "transitions": [
        {
          "target": "done",
          "when": {
            "status": "ok"
          }
        },
        {
          "target": "failed_result",
          "when": {
            "status": "fail"
          }
        }
      ],
      "accepts": {
        "status": {
          "field_type": "enum",
          "required": true,
          "values": [
            "ok",
            "fail"
          ]
        }
      }
    }
  }
}