{
  "format_version": 1,
  "name": "compat-failure-reporting-context",
  "version": "1.0",
  "description": "Assigns the published-location key on a transition, so a later write of the same key by koto itself shows whether an older koto reading the log restores the stale assigned value over it",
  "initial_state": "start",
  "states": {
    "done": {
      "directive": "Done.",
      "terminal": true
    },
    "hold": {
      "directive": "Hold until told to go on.",
      "transitions": [
        {
          "target": "done",
          "when": {
            "step": "go"
          }
        }
      ],
      "accepts": {
        "step": {
          "field_type": "enum",
          "required": true,
          "values": [
            "go"
          ]
        }
      }
    },
    "start": {
      "directive": "Start.",
      "transitions": [
        {
          "target": "hold",
          "when": {
            "step": "go"
          },
          "context_assignments": {
            "workflows/publish-location": "stale-from-transition"
          }
        }
      ],
      "accepts": {
        "step": {
          "field_type": "enum",
          "required": true,
          "values": [
            "go"
          ]
        }
      }
    }
  }
}