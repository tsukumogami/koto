# Rust build artifacts
/target/

# IDE
.idea/
.vscode/
*.swp
*.swo

# Local-only files (*.local* covers .local.env, CLAUDE.local.md, settings.local.json, etc.)
*.local*

# Claude Code workspace (keep only committed settings)
.claude/*
!.claude/settings.json
# And the shirabe-extensions directory, which holds koto's /work-on verification
# map (work-on.md) and must ship in the repo. The distributed *.local.md
# extensions in the same directory stay ignored by *.local* above.
!.claude/shirabe-extensions/

# Eval workspace artifacts (generated by run-evals.sh)
**/evals/workspace/
