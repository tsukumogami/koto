{
  "schema": "shirabe-verification-map/v1",
  "commands": {
    "cargo-test": {"run": ["bash", "scripts/without-session-env.sh", "cargo", "test", "--locked", "--", "--test-threads=1"], "timeout_secs": 3600},
    "stability-tests": {"run": ["bash", "scripts/without-session-env.sh", "cargo", "test", "-p", "koto-stability-tests", "--", "--test-threads=1"], "timeout_secs": 3600},
    "fmt": {"run": ["bash", "scripts/without-session-env.sh", "cargo", "fmt", "--check"]},
    "clippy": {"run": ["bash", "scripts/without-session-env.sh", "cargo", "clippy", "--all-targets", "--", "-D", "warnings"], "timeout_secs": 3600},
    "decider-purity": {"run": ["bash", "scripts/without-session-env.sh", "bash", "scripts/check-decider-purity.sh"]},
    "doc-names": {"run": ["bash", "scripts/without-session-env.sh", "cargo", "test", "--locked", "--test", "doc_names"], "timeout_secs": 3600},
    "plugin-hooks-shape": {"run": ["bash", "scripts/without-session-env.sh", "cargo", "test", "--locked", "--test", "plugin_hooks_shape"], "timeout_secs": 3600},
    "shipped-spec": {"run": ["bash", "scripts/without-session-env.sh", "cargo", "test", "--locked", "--lib", "shipped_spec"], "timeout_secs": 3600},
    "evals-exist": {"run": ["bash", "scripts/without-session-env.sh", "bash", "scripts/check-evals-exist.sh"]},
    "inline-evidence": {"run": ["bash", "scripts/without-session-env.sh", "bash", "scripts/check-inline-evidence_test.sh"]},
    "session-start-workflows-hook": {"run": ["bash", "scripts/without-session-env.sh", "bash", "plugins/koto-skills/hooks/test/session-start-workflows.test.sh"]},
    "run-evals-test": {"run": ["bash", "scripts/without-session-env.sh", "bash", "scripts/run-evals_test.sh"]}
  },
  "entries": [
    {
      "paths": ["src/**", "tests/**", "test/functional/fixtures/**", "benches/**", "koto-stability-tests/**", "build.rs", "Cargo.toml", "Cargo.lock", "README.md", "CLAUDE.md", "scripts/without-session-env.sh"],
      "commands": ["cargo-test", "stability-tests", "fmt", "clippy", "decider-purity"]
    },
    {
      "paths": ["plugins/**", ".claude-plugin/**", "scripts/check-evals-exist.sh", "scripts/check-inline-evidence.sh", "scripts/check-inline-evidence_test.sh"],
      "commands": ["doc-names", "plugin-hooks-shape", "evals-exist", "inline-evidence", "session-start-workflows-hook"]
    },
    {
      "paths": ["docs/**"],
      "commands": ["doc-names", "shipped-spec"]
    },
    {
      "paths": ["scripts/run-evals.sh", "scripts/run-evals_test.sh", "scripts/classify-eval-session.py"],
      "commands": ["run-evals-test"]
    }
  ],
  "default": ["cargo-test", "stability-tests", "fmt", "clippy"]
}
